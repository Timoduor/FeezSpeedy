@model FeezSpeedy.Web.ViewModels.DependantViewModel
@{
    ViewData["Title"] = "Add Dependant";
}

<h2>Add Dependant</h2>

<form asp-action="AddDependant" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AdmissionNumber"></label>
        <input asp-for="AdmissionNumber" class="form-control" />
        <span asp-validation-for="AdmissionNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ClassLevel"></label>
        <input asp-for="ClassLevel" class="form-control" />
        <span asp-validation-for="ClassLevel" class="text-danger"></span>
    </div>

    <!-- School dropdown + manual input -->
    <div class="mb-3">
        <label for="schoolInput">School</label>
        <input type="text" id="schoolInput" name="SchoolName" class="form-control" placeholder="Type or select a school" list="schoolsList" />
        <datalist id="schoolsList">
            @foreach (var school in ViewBag.Schools)
            {
                <option value="@school.Name"></option>
            }
        </datalist>
    </div>

    <button type="submit" class="btn btn-primary">Add Dependant</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}